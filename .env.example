# Copy this file to .env and fill in your values
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Postgres (self-hosted via docker-compose's postgres service)
POSTGRES_USER=beers
POSTGRES_PASSWORD=use_a_long_random_value_here
POSTGRES_DB=beers
# Inside the docker-compose network the bot reaches Postgres by service name.
DATABASE_URL=postgresql://beers:use_a_long_random_value_here@postgres:5432/beers
